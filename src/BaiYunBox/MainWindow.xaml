<Window x:Class="BaiYunBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:BaiYunBox.UI.Pages"
        Title="BaiYun Box"
        Width="1200" Height="760"
        MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧导航 -->
        <Border Grid.Column="0" Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,20,16,12">
                    <TextBlock Text="BaiYun Box" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource ForegroundBrush}"/>
                    <TextBlock Text="离线影视 · 播客" FontSize="11" Foreground="{StaticResource SecondaryForegroundBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <ListBox x:Name="NavList" DockPanel.Dock="Top" BorderThickness="0"
                         Background="Transparent" SelectionChanged="Nav_SelectionChanged">
                    <ListBoxItem Content="🏠 首页" Tag="0" Padding="12,10"/>
                    <ListBoxItem Content="🎬 点播" Tag="1" Padding="12,10"/>
                    <ListBoxItem Content="📺 直播" Tag="2" Padding="12,10"/>
                    <ListBoxItem Content="📁 媒体库" Tag="3" Padding="12,10"/>
                    <ListBoxItem Content="🎙 播客" Tag="4" Padding="12,10"/>
                    <ListBoxItem Content="⚙ 设置" Tag="5" Padding="12,10"/>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 右侧内容区 -->
        <Grid Grid.Column="1">
            <pages:HomePage x:Name="HomePageControl" Visibility="Visible"/>
            <pages:VodPage x:Name="VodPageControl" Visibility="Collapsed"/>
            <pages:LivePage x:Name="LivePageControl" Visibility="Collapsed"/>
            <pages:LibraryPage x:Name="LibraryPageControl" Visibility="Collapsed"/>
            <pages:PodcastPage x:Name="PodcastPageControl" Visibility="Collapsed"/>
            <pages:SettingsPage x:Name="SettingsPageControl" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
