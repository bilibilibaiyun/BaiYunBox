<Window x:Class="BaiYunBox.UI.TranscriptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="转录结果" Width="720" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="Bold"
                   Foreground="{StaticResource ForegroundBrush}" TextTrimming="CharacterEllipsis"/>

        <Border Grid.Row="1" Margin="0,12,0,12" Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="6">
            <TextBox x:Name="TextBox" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="12"
                     Foreground="{StaticResource ForegroundBrush}" Background="Transparent"
                     FontSize="13"/>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="复制全文" Width="100" Height="30" Margin="0,0,8,0"
                    Click="Copy_Click" Cursor="Hand"/>
            <Button Content="另存为…" Width="100" Height="30" Margin="0,0,8,0"
                    Click="Save_Click" Cursor="Hand"/>
            <Button Content="关闭" Width="80" Height="30"
                    Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"
                    Click="Close_Click" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
