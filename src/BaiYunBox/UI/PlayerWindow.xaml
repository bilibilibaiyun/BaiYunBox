<Window x:Class="BaiYunBox.UI.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BaiYunBox.UI"
        Title="BaiYun Box 播放器"
        Width="960" Height="600"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#000000"
        KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#1B1F24" Padding="12,8">
            <Grid>
                <TextBlock x:Name="TitleText" Text="正在播放" Foreground="White" FontSize="14"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <Button Content="✕" HorizontalAlignment="Right" Width="30" Height="26"
                        Background="Transparent" Foreground="#CCCCCC" BorderThickness="0"
                        FontSize="14" Click="Close_Click" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- 视频区域 -->
        <Grid Grid.Row="1" Background="Black">
            <ui:MpvHost x:Name="MpvHostControl" />
            <!-- 未加载/加载提示 -->
            <TextBlock x:Name="StatusText" Text="加载中…" Foreground="#AAAAAA" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- 控制条 -->
        <Border Grid.Row="2" Background="#1B1F24" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="PlayPauseBtn" Grid.Column="0" Content="▶" Width="40" Height="32"
                        Background="#2563EB" Foreground="White" BorderThickness="0" FontSize="14"
                        Click="PlayPause_Click" Cursor="Hand"/>

                <TextBlock x:Name="PositionText" Grid.Column="1" Text="00:00" Foreground="#CCCCCC"
                           FontSize="12" Margin="10,0,4,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="/" Foreground="#888888" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="DurationText" Grid.Column="2" Text="00:00" Foreground="#888888"
                           FontSize="12" Margin="14,0,10,0" VerticalAlignment="Center"/>

                <Slider x:Name="ProgressSlider" Grid.Column="3" Minimum="0" Maximum="100" Value="0"
                        VerticalAlignment="Center" Margin="0,0,12,0"
                        PreviewMouseDown="Progress_PreviewMouseDown"
                        PreviewMouseUp="Progress_PreviewMouseUp"/>

                <TextBlock Grid.Column="4" Text="倍速" Foreground="#888888" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                <ComboBox x:Name="SpeedBox" Grid.Column="5" Width="64" Height="28" FontSize="12"
                          SelectedIndex="3" SelectionChanged="Speed_Changed" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="6" Text="音量" Foreground="#888888" FontSize="12" Margin="12,0,4,0" VerticalAlignment="Center"/>
                <Slider x:Name="VolumeSlider" Grid.Column="6" Width="80" Minimum="0" Maximum="100" Value="80"
                        VerticalAlignment="Center" Margin="16,0,0,0" ValueChanged="Volume_Changed"/>
            </Grid>
        </Border>
    </Grid>
</Window>
