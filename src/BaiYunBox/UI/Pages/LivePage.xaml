<UserControl x:Class="BaiYunBox.UI.Pages.LivePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBackground}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="直播" FontSize="20" FontWeight="Bold" Foreground="{StaticResource ForegroundBrush}"/>

        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="直播源" VerticalAlignment="Center" Foreground="{StaticResource ForegroundBrush}"/>
            <ComboBox x:Name="SourceBox" Grid.Column="1" Width="320" Height="28" Margin="12,0,0,0"/>
            <Button Grid.Column="2" Content="加载" Width="70" Height="28" Margin="12,0,0,0"
                    Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"
                    Click="Load_Click" Cursor="Hand"/>
            <TextBlock x:Name="StatusText" Grid.Column="3" FontSize="12" VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryForegroundBrush}"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 分组 -->
            <ListBox x:Name="GroupList" Grid.Column="0" BorderThickness="0" Background="Transparent"
                     SelectionChanged="Group_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" FontSize="13" Padding="8,6"
                                   Foreground="{StaticResource ForegroundBrush}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 频道 -->
            <ListBox x:Name="ChannelList" Grid.Column="1" Margin="12,0,0,0"
                     BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1"
                     Background="{StaticResource PanelBackground}"
                     MouseDoubleClick="ChannelList_DoubleClick"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" FontSize="13" Padding="8,6"
                                       Foreground="{StaticResource ForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="1" Content="▶" Width="40" Height="26" Margin="8,4"
                                    Background="{StaticResource AccentBrush}" Foreground="White"
                                    BorderThickness="0" FontSize="11" Tag="{Binding}"
                                    Click="Play_Click" Cursor="Hand"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
