<UserControl x:Class="BaiYunBox.UI.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <TextBlock Text="设置" FontSize="20" FontWeight="Bold" Foreground="{StaticResource ForegroundBrush}"/>

            <!-- 点播源 -->
            <GroupBox Header="点播源（TVBox / FongMi JSON 地址）" Margin="0,16,0,0" Padding="12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="VodSourceBox" Height="30" VerticalContentAlignment="Center"
                                 Padding="6,0" ToolTip="粘贴 TVBox 单线路源或 FongMi 多线路源的 JSON 地址"/>
                        <Button Grid.Column="1" Content="添加" Width="70" Height="30" Margin="8,0,0,0"
                                Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"
                                Click="AddVodSource_Click" Cursor="Hand"/>
                    </Grid>
                    <ListBox x:Name="VodSourceList" MaxHeight="120" Margin="0,8,0,0"
                             SelectionChanged="VodSource_SelectionChanged"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="删除选中" Width="90" Height="28" Click="RemoveVodSource_Click"/>
                        <Button Content="立即加载" Width="90" Height="28" Margin="8,0,0,0"
                                Click="ReloadVod_Click"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- 直播源 -->
            <GroupBox Header="直播源（M3U / M3U8 / TXT 地址或本地路径）" Margin="0,12,0,0" Padding="12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="LiveSourceBox" Height="30" VerticalContentAlignment="Center" Padding="6,0"/>
                        <Button Grid.Column="1" Content="添加" Width="70" Height="30" Margin="8,0,0,0"
                                Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"
                                Click="AddLiveSource_Click" Cursor="Hand"/>
                    </Grid>
                    <ListBox x:Name="LiveSourceList" MaxHeight="100" Margin="0,8,0,0"
                             SelectionChanged="LiveSource_SelectionChanged"/>
                    <Button Content="删除选中" Width="90" Height="28" Margin="0,8,0,0"
                            Click="RemoveLiveSource_Click"/>
                </StackPanel>
            </GroupBox>

            <!-- 本地媒体目录 -->
            <GroupBox Header="本地媒体目录" Margin="0,12,0,0" Padding="12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MediaDirBox" Height="30" VerticalContentAlignment="Center" Padding="6,0" IsReadOnly="True"/>
                        <Button Grid.Column="1" Content="浏览…" Width="70" Height="30" Margin="8,0,0,0"
                                Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"
                                Click="AddMediaDir_Click" Cursor="Hand"/>
                    </Grid>
                    <ListBox x:Name="MediaDirList" MaxHeight="100" Margin="0,8,0,0"/>
                    <Button Content="删除选中" Width="90" Height="28" Margin="0,8,0,0"
                            Click="RemoveMediaDir_Click"/>
                </StackPanel>
            </GroupBox>

            <!-- 播放设置 -->
            <GroupBox Header="播放设置" Margin="0,12,0,0" Padding="12">
                <StackPanel>
                    <CheckBox x:Name="AutoNextBox" Content="自动切集（播完自动下一集）" Margin="0,4,0,0"
                              Checked="PlaySetting_Changed" Unchecked="PlaySetting_Changed"/>
                    <CheckBox x:Name="AutoSwitchBox" Content="自动换源（失败/缓冲时切换线路）" Margin="0,8,0,0"
                              Checked="PlaySetting_Changed" Unchecked="PlaySetting_Changed"/>
                    <CheckBox x:Name="PreloadBox" Content="下一集预载" Margin="0,8,0,0"
                              Checked="PlaySetting_Changed" Unchecked="PlaySetting_Changed"/>
                </StackPanel>
            </GroupBox>

            <!-- 界面 -->
            <GroupBox Header="界面" Margin="0,12,0,0" Padding="12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="主题" VerticalAlignment="Center" Foreground="{StaticResource ForegroundBrush}"/>
                    <ComboBox x:Name="ThemeBox" Width="140" Height="28" Margin="12,0,0,0"
                              SelectionChanged="Theme_Changed">
                        <ComboBoxItem Content="日间" Tag="light"/>
                        <ComboBoxItem Content="夜间" Tag="dark"/>
                    </ComboBox>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
