<UserControl x:Class="BaiYunBox.UI.Pages.LibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBackground}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="本地媒体库" FontSize="20" FontWeight="Bold" Foreground="{StaticResource ForegroundBrush}"/>

        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="目录" VerticalAlignment="Center" Foreground="{StaticResource ForegroundBrush}"/>
            <ComboBox x:Name="DirBox" Grid.Column="1" Height="28" Margin="12,0,0,0"/>
            <Button Grid.Column="2" Content="扫描" Width="70" Height="28" Margin="12,0,0,0"
                    Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"
                    Click="Scan_Click" Cursor="Hand"/>
            <TextBlock x:Name="StatusText" Grid.Column="3" FontSize="12" VerticalAlignment="Center"
                       Margin="12,0,0,0" Foreground="{StaticResource SecondaryForegroundBrush}"/>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ListBox x:Name="VideoList" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="VideoList_DoubleClick">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="180" Margin="0,0,14,14" Background="{StaticResource PanelBackground}"
                                CornerRadius="8" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1"
                                Cursor="Hand">
                            <StackPanel>
                                <Border Width="180" Height="120" Background="#1A1D22" CornerRadius="8,8,0,0">
                                    <Image Source="{Binding PosterPath}" Stretch="UniformToFill"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding Name}" FontSize="12" Padding="10,8"
                                           Foreground="{StaticResource ForegroundBrush}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
    </Grid>
</UserControl>
