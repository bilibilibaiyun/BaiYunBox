<UserControl x:Class="BaiYunBox.UI.Pages.VodPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBackground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部搜索框（TVbox 风格：常驻顶部） -->
        <Grid Grid.Row="0" Margin="24,20,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource PanelBackground}" CornerRadius="6"
                    BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="{StaticResource SecondaryForegroundBrush}"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" Height="34" BorderThickness="0"
                             Background="Transparent" VerticalContentAlignment="Center" Padding="8,0"
                             Foreground="{StaticResource ForegroundBrush}" FontSize="14"
                             ToolTip="输入片名 / 演员 / 关键词，回车搜索" KeyDown="SearchBox_KeyDown"/>
                </Grid>
            </Border>
            <Button Grid.Column="1" Content="搜索" Width="72" Height="34" Margin="10,0,0,0"
                    Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"
                    FontSize="13" Click="Search_Click" Cursor="Hand"/>
        </Grid>

        <!-- 站点 + 分类横条 -->
        <Grid Grid.Row="1" Margin="24,12,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="SiteBox" Width="160" Height="30" VerticalAlignment="Center"
                      SelectionChanged="Site_SelectionChanged"/>
            <ListBox x:Name="CategoryList" Grid.Column="1" Margin="12,0,0,0" BorderThickness="0"
                     Background="Transparent" SelectionChanged="Category_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,4,0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" Padding="14,5" CornerRadius="6"
                                            Cursor="Hand">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding TypeName}" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- 浏览视图：海报墙 -->
        <Grid x:Name="BrowseView" Grid.Row="2" Margin="24,12,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ListBox x:Name="VodList" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="VodList_DoubleClick">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="150" Margin="0,0,12,14" Background="{StaticResource PanelBackground}"
                                    CornerRadius="8" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1"
                                    Cursor="Hand">
                                <StackPanel>
                                    <Border Width="150" Height="100" Background="#1A1D22" CornerRadius="8,8,0,0">
                                        <Grid>
                                            <Image Source="{Binding Pic}" Stretch="UniformToFill"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Remarks}" HorizontalAlignment="Right"
                                                       VerticalAlignment="Top" Margin="0,4,4,0" FontSize="10"
                                                       Foreground="White" Padding="4,1">
                                                <TextBlock.Background>
                                                    <SolidColorBrush Color="#CC2563EB"/>
                                                </TextBlock.Background>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontSize="12" Padding="8,6"
                                               Foreground="{StaticResource ForegroundBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,4" HorizontalAlignment="Center">
                <Button Content="上一页" Width="80" Height="30" Click="PrevPage_Click"/>
                <TextBlock x:Name="PageText" Text="1" Margin="14,0" VerticalAlignment="Center"
                           Foreground="{StaticResource ForegroundBrush}"/>
                <Button Content="下一页" Width="80" Height="30" Click="NextPage_Click"/>
            </StackPanel>
        </Grid>

        <!-- 详情视图：选集 + 线路 -->
        <Grid x:Name="DetailView" Grid.Row="2" Margin="24,12,24,0" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Button Content="← 返回" Width="80" Height="32" Click="Back_Click" Cursor="Hand"/>
                <TextBlock x:Name="DetailTitle" FontSize="20" FontWeight="Bold" Margin="16,0,0,0"
                           VerticalAlignment="Center" Foreground="{StaticResource ForegroundBrush}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
                <TextBlock Text="线路" VerticalAlignment="Center" Foreground="{StaticResource ForegroundBrush}"/>
                <ComboBox x:Name="LineBox" Width="200" Height="30" Margin="12,0,0,0"
                          SelectionChanged="Line_SelectionChanged"/>
            </StackPanel>

            <TextBlock Grid.Row="2" x:Name="DetailInfo" FontSize="12" Margin="0,10,0,10"
                       Foreground="{StaticResource SecondaryForegroundBrush}" TextWrapping="Wrap"/>

            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <ListBox x:Name="EpisodeList" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Title}" MinWidth="64" Height="32"
                                    Margin="0,0,8,8" Padding="12,0" FontSize="12"
                                    Background="{StaticResource PanelBackground}"
                                    Foreground="{StaticResource ForegroundBrush}"
                                    BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1"
                                    Tag="{Binding}" Click="Episode_Click" Cursor="Hand"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
