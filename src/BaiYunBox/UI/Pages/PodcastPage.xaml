<UserControl x:Class="BaiYunBox.UI.Pages.PodcastPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBackground}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="播客" FontSize="20" FontWeight="Bold" Foreground="{StaticResource ForegroundBrush}"/>

        <!-- 工具栏 -->
        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="RSS" VerticalAlignment="Center" Foreground="{StaticResource ForegroundBrush}"/>
            <TextBox x:Name="RssBox" Grid.Column="1" Height="28" Margin="8,0,0,0" Padding="6,0"
                     VerticalContentAlignment="Center" ToolTip="粘贴播客 RSS / Apple / 小宇宙 / 喜马拉雅 地址"/>
            <Button Grid.Column="2" Content="导入订阅" Width="80" Height="28" Margin="8,0,0,0"
                    Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"
                    Click="ImportRss_Click" Cursor="Hand"/>
            <Button Grid.Column="3" Content="搜索节目" Width="80" Height="28" Margin="8,0,0,0"
                    Click="Search_Click" Cursor="Hand"/>
            <Button Grid.Column="4" Content="导入本地音频" Width="110" Height="28" Margin="8,0,0,0"
                    Background="#16A34A" Foreground="White" BorderThickness="0"
                    Click="ImportLocal_Click" Cursor="Hand"/>
        </Grid>

        <!-- 主体 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 订阅列表 -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="我的订阅" FontSize="13" FontWeight="SemiBold"
                           Margin="0,0,0,8" Foreground="{StaticResource ForegroundBrush}"/>
                <ListBox x:Name="SubList" DockPanel.Dock="Top" BorderThickness="0" Background="Transparent"
                         SelectionChanged="Sub_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" FontSize="13" Padding="8,6"
                                       Foreground="{StaticResource ForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button DockPanel.Dock="Bottom" Content="取消订阅" Height="28" Margin="0,8,0,0"
                        Click="RemoveSub_Click"/>
            </DockPanel>

            <!-- 剧集/搜索结果列表 -->
            <Grid Grid.Column="1" Margin="12,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="ListTitle" Text="请选择订阅或搜索节目" FontSize="13" FontWeight="SemiBold"
                           Margin="0,0,0,8" Foreground="{StaticResource ForegroundBrush}"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="EpisodeItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PanelBackground}" CornerRadius="8"
                                        BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1"
                                        Padding="12,8" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource ForegroundBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="11" Foreground="{StaticResource SecondaryForegroundBrush}"
                                                       Margin="0,3,0,0">
                                                <Run Text="{Binding Published, StringFormat={}{0:yyyy-MM-dd}}"/>
                                                <Run Text="  "/>
                                                <Run Text="{Binding DurationDisplay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="播放" Width="52" Height="26" Margin="4,0"
                                                    Background="{StaticResource AccentBrush}" Foreground="White"
                                                    BorderThickness="0" FontSize="11" Tag="{Binding}"
                                                    Click="PlayEpisode_Click" Cursor="Hand"/>
                                            <Button Content="下载" Width="52" Height="26" Margin="4,0"
                                                    BorderThickness="1" FontSize="11" Tag="{Binding}"
                                                    Click="DownloadEpisode_Click" Cursor="Hand"/>
                                            <Button Content="转录" Width="52" Height="26" Margin="4,0"
                                                    BorderThickness="1" FontSize="11" Tag="{Binding}"
                                                    Click="TranscribeEpisode_Click" Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LocalPath}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="订阅" Width="52" Height="26" Margin="4,0"
                                                    Background="#16A34A" Foreground="White" BorderThickness="0"
                                                    FontSize="11" Tag="{Binding}" Click="SubscribeResult_Click" Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SubscribeFeedUrl}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- 转录进度/状态条 -->
        <Border x:Name="TranscribeBar" Grid.Row="2" Visibility="Collapsed"
                Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrushColor}"
                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <StackPanel>
                <TextBlock x:Name="TranscribeStatus" FontSize="12" Foreground="{StaticResource ForegroundBrush}"/>
                <ProgressBar x:Name="TranscribeProgress" Height="8" Width="300" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
