<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <AssemblyName>BaiYunBox</AssemblyName>
    <RootNamespace>BaiYunBox</RootNamespace>
    <Version>1.0.3</Version>
    <AssemblyVersion>1.0.3.0</AssemblyVersion>
    <FileVersion>1.0.3.0</FileVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>zh-CN;en-US</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- JS 爬虫（dr_py 声明式 rule）支持：Jint 纯托管 JS 引擎 + AngleSharp 纯托管 HTML 解析。
         两者均为 managed 程序集，无 native 依赖，保持轻量。 -->
    <PackageReference Include="Jint" Version="4.3.0" />
    <PackageReference Include="AngleSharp" Version="1.2.0" />
    <!-- 只用 WinForms 的 NotifyIcon/FolderBrowserDialog，移除其 implicit using 以避免与 WPF 控件类型歧义 -->
    <Using Remove="System.Windows.Forms" />
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- 内置 libmpv 引擎（libmpv-2.dll）。用 Always 而非 PreserveNewest：引擎文件的修改
         时间是构建/下载时间，PreserveNewest 会误判旧文件「更新」而不复制，导致发布/安装包残留旧引擎。 -->
    <None Include="..\..\engine\mpv\**\*"
          Link="engine\mpv\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="Always"
          CopyToPublishDirectory="Always" />
  </ItemGroup>

</Project>
